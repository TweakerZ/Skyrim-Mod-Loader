<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The in-app UI is Material You (dynamic colour). The native window only
      covers the cold-start frame, so it follows the system light/dark mode
      instead of the old fixed near-black palette.
    -->
    <style name="Theme.DroidModLoader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dml_window_background</item>
        <item name="android:colorBackground">@color/dml_window_background</item>
        <item name="android:statusBarColor">@color/dml_window_background</item>
        <item name="android:navigationBarColor">@color/dml_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
